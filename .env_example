# Database Settings (AWS RDS MySQL - notification_db)
DB_HOST=your_rds_host
DB_PORT=3306
DB_NAME=notification_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_secret_password

# JWT Settings (통합 공유 비밀키)
JWT_SECRET=your_super_secret_jwt_signature_key_for_auth_service

# MSA Internal Auth Header Secret (서버 간 내부망 통신 보안 암호)
INTERNAL_SECRET_KEY=your_msa_shared_internal_secret_key

# Firebase Cloud Messaging 인증용 JSON 키 경로.
# 로컬: classpath 기반 (src/main/resources/ 에 파일 위치)
# 도커/EC2: file:/app/firebase-service-account.json (volume mount로 주입)
FIREBASE_CONFIG_PATH=classpath:firebase-service-account.json

# MSA 내부 서비스 통신 URL (개발 서버용 - 경로 기반 라우팅)
SERVICES_DEVICE_URL=https://dev.after-buy.r-e.kr/api/devices
SERVICES_ADMIN_URL=https://dev.after-buy.r-e.kr/api/admin
